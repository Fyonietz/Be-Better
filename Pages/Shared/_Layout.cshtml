<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Productive_Maxxing</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Productive_Maxxing.styles.css" asp-append-version="true" />
    <style>
        /* Minimal floating navbar */
        .floating-navbar {
            position: fixed;
            top: 10px;
            left: 50%;
            transform: translateX(-50%);
            width: 90%;
            max-width: 1200px;
            z-index: 1000;
            box-shadow: 0 1px 5px rgba(0,0,0,0.1);
            border-radius: 6px;
            padding: 0 !important;
            min-height: 40px;
        }

        .floating-navbar .container {
            padding: 0 10px;
        }

        .floating-navbar .navbar-brand {
            font-size: 1rem;
            padding: 8px 0;
        }

        .floating-navbar .nav-link {
            padding: 8px 10px;
            font-size: 0.9rem;
        }

        /* Minimal floating footer */
        .floating-footer {
            position: fixed;
            bottom: 10px;
            left: 50%;
            transform: translateX(-50%);
            width: 90%;
            max-width: 1200px;
            z-index: 1000;
            box-shadow: 0 -1px 5px rgba(0,0,0,0.1);
            border-radius: 6px;
            padding: 0 !important;
            min-height: 30px;
        }

        .floating-footer .container {
            padding: 5px 10px;
            font-size: 0.8rem;
        }

        /* Adjust body padding */
        body {
            padding-top: 60px;
            padding-bottom: 50px;
        }

        .container {
            padding-top: 10px;
        }
    </style>
</head>
<body>
    <!-- Floating Navbar -->
    <nav class="floating-navbar navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow">
        <div class="container">
            <a class="navbar-brand" asp-area="" asp-page="/Index">Be Better</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-page="/Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-page="/Money">Money</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

       <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
