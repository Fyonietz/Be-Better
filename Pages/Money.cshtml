@page
@model MoneyModel
@using System.Globalization

@{
    var culture = new CultureInfo("id-ID");
    ViewData["Title"] = "Money Management";
}

<!-- Anti-forgery token for AJAX -->
@Html.AntiForgeryToken()

<div class="app">

    <!-- SIDEBAR -->
    <aside class="sidebar">
        <button onclick="show('dashboard')">Dashboard</button>
        <button onclick="show('kebutuhan')">Kebutuhan</button>
        <button onclick="show('tabungan')">Tabungan</button>
        <button onclick="show('logs')">Logs</button>
    </aside>

    <!-- MAIN CONTENT -->
    <main class="content">

        <!-- DASHBOARD -->
        <section id="dashboard" class="view active">
            <h2>Dashboard</h2>
            <p>Total Kebutuhan (dummy)</p>
            <h1>Rp 0</h1>
        </section>

        <!-- KEBUTUHAN SPA -->
        <section id="kebutuhan" class="view">

            <!-- TAB NAVIGATION -->
            <div class="tab-nav">
                <button class="tab-button active" onclick="showTab('formTab')">Form</button>
                <button class="tab-button" onclick="showTab('listTab')">List</button>
            </div>

            <!-- TAB CONTENT -->
            <div class="tab-content-wrapper">
                
                <!-- FORM TAB -->
                <div id="formTab" class="tab-content active">
                    <div class="form-group rectangle">
                        <h3>Tambah Kebutuhan</h3>
                        
                        <label for="nama">Nama</label>
                        <input type="text" id="nama" placeholder="Nama" />
                        
                        <label for="nominal">Nominal</label>
                        <input type="number" id="nominal" step="0.01" placeholder="Nominal" oninput="updateCurrencyPreview()" />
                        <p class="text-muted">Preview: <span id="currencyPreview">Rp 0</span></p>
                        
                        <label for="notes">Notes</label>
                        <input type="text" id="notes" placeholder="Notes" />
                        
                        <button type="button" class="btn-primary" onclick="tambahKebutuhan()">Tambah</button>
                    </div>
                </div>

                <!-- LIST TAB -->
                <div id="listTab" class="tab-content">
                    <!-- PAGINATION CONTROLS -->
                    <div class="pagination-controls">
                        <button class="btn" onclick="changePage(-1)">Previous</button>
                        <span>Page <span id="currentPage">1</span> of <span id="totalPages">1</span></span>
                        <button class="btn" onclick="changePage(1)">Next</button>
                        <select id="itemsPerPage" onchange="loadKebutuhanList()">
                            <option value="5">5 per page</option>
                            <option value="10" selected>10 per page</option>
                            <option value="25">25 per page</option>
                            <option value="50">50 per page</option>
                        </select>
                    </div>

                    <!-- LIST TABLE -->
                    <table id="kebutuhanTable" class="table table-striped table-bordered">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Nama</th>
                                <th>Nominal</th>
                                <th>Notes</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- JS will populate this -->
                        </tbody>
                    </table>
                </div>

            </div>

            <!-- EDIT MODAL -->
            <div id="editModal" class="modal">
                <div class="modal-content">
                    <div class="modal-header">
                        <h3>Edit Kebutuhan</h3>
                        <button type="button" class="btn" onclick="closeEditModal()">×</button>
                    </div>
                    
                    <input id="editId" type="hidden" />
                    
                    <label for="editNama">Nama</label>
                    <input id="editNama" type="text" placeholder="Nama" />
                    
                    <label for="editNominal">Nominal</label>
                    <input id="editNominal" type="number" step="0.01" placeholder="Nominal" oninput="updateEditCurrencyPreview()" />
                    <p class="text-muted">Preview: <span id="editCurrencyPreview">Rp 0</span></p>
                    
                    <label for="editNotes">Notes</label>
                    <input id="editNotes" type="text" placeholder="Notes" />
                    
                    <div class="modal-footer">
                        <button type="button" class="btn" onclick="closeEditModal()">Cancel</button>
                        <button type="button" class="btn-primary" onclick="saveEdit()">Save</button>
                    </div>
                </div>
            </div>
        </section>

        <!-- TABUNGAN -->
        <section id="tabungan" class="view">
            <h2>Transaksi</h2>
            <p>Coming soon…</p>
        </section>

        <!-- LOGS -->
        <section id="logs" class="view">
            <h2>Logs</h2>
            <p>Coming soon…</p>
        </section>

    </main>
</div>

<!-- JAVASCRIPT -->
<script>
// Pagination variables
let currentPage = 1;
let allData = [];

function getToken() {
    return document.querySelector('input[name="__RequestVerificationToken"]').value;
}

function show(id) {
    document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
    document.getElementById(id).classList.add('active');
}

// Tab switching
function showTab(tabId) {
    // Remove active class from all tabs
    document.querySelectorAll('.tab-button').forEach(btn => btn.classList.remove('active'));
    document.querySelectorAll('.tab-content').forEach(content => content.classList.remove('active'));
    
    // Add active class to selected tab
    event.target.classList.add('active');
    document.getElementById(tabId).classList.add('active');
}

// Currency formatter
function formatCurrency(value) {
    return new Intl.NumberFormat('id-ID', {
        style: 'currency',
        currency: 'IDR',
        minimumFractionDigits: 0
    }).format(value);
}

// Update currency preview for add form
function updateCurrencyPreview() {
    const value = document.getElementById('nominal').value;
    const preview = document.getElementById('currencyPreview');
    preview.textContent = value ? formatCurrency(parseFloat(value)) : 'Rp 0';
}

// Update currency preview for edit form
function updateEditCurrencyPreview() {
    const value = document.getElementById('editNominal').value;
    const preview = document.getElementById('editCurrencyPreview');
    preview.textContent = value ? formatCurrency(parseFloat(value)) : 'Rp 0';
}

// Load Kebutuhan table with pagination
async function loadKebutuhanList() {
    try {
        const response = await fetch('/Money?handler=KebutuhanList');
        if (!response.ok) throw new Error('Failed to fetch Kebutuhan list');
        allData = await response.json();
        
        renderTable();
    } catch (err) {
        console.error('Fetch error:', err);
    }
}

// Render table with pagination
function renderTable() {
    const itemsPerPage = parseInt(document.getElementById('itemsPerPage').value);
    const totalPages = Math.ceil(allData.length / itemsPerPage);
    
    // Update pagination info
    document.getElementById('currentPage').textContent = currentPage;
    document.getElementById('totalPages').textContent = totalPages || 1;
    
    // Calculate start and end index
    const startIndex = (currentPage - 1) * itemsPerPage;
    const endIndex = startIndex + itemsPerPage;
    const pageData = allData.slice(startIndex, endIndex);
    
    // Render table rows
    const tbody = document.querySelector('#kebutuhanTable tbody');
    tbody.innerHTML = '';

    if (pageData.length === 0) {
        tbody.innerHTML = '<tr><td colspan="5" class="text-center">No data available</td></tr>';
        return;
    }

    pageData.forEach(k => {
        const row = `<tr>
            <td>${k.id}</td>
            <td>${k.nama}</td>
            <td>${formatCurrency(k.nominal)}</td>
            <td>${k.notes}</td>
            <td>
                <button class="btn" onclick="openEditModal(${k.id}, '${k.nama}', ${k.nominal}, '${k.notes}')">Edit</button>
                <button class="btn" onclick="deleteKebutuhan(${k.id})">Delete</button>
            </td>
        </tr>`;
        tbody.innerHTML += row;
    });
}

// Change page
function changePage(direction) {
    const itemsPerPage = parseInt(document.getElementById('itemsPerPage').value);
    const totalPages = Math.ceil(allData.length / itemsPerPage);
    
    currentPage += direction;
    
    // Prevent going out of bounds
    if (currentPage < 1) currentPage = 1;
    if (currentPage > totalPages) currentPage = totalPages;
    
    renderTable();
}

// Add Kebutuhan
async function tambahKebutuhan() {
    const nama = document.getElementById('nama').value;
    const nominal = Number(document.getElementById('nominal').value) || 0;
    const notes = document.getElementById('notes').value;

    if (!nama) { 
        alert("Nama is required"); 
        return; 
    }

    if (nominal <= 0) {
        alert("Nominal must be greater than 0");
        return;
    }

    try {
        const response = await fetch('?handler=TambahKebutuhan', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': getToken()
            },
            body: JSON.stringify({ nama, nominal, notes })
        });
        const result = await response.json();
        if (result.success) {
            // Clear form
            document.getElementById('nama').value = '';
            document.getElementById('nominal').value = '';
            document.getElementById('notes').value = '';
            document.getElementById('currencyPreview').textContent = 'Rp 0';
            
            // Reload list
            await loadKebutuhanList();
            
            alert('Data berhasil ditambahkan!');
            
            // Auto switch to list tab
            document.querySelectorAll('.tab-button').forEach(btn => btn.classList.remove('active'));
            document.querySelectorAll('.tab-content').forEach(content => content.classList.remove('active'));
            document.querySelector('.tab-button:nth-child(2)').classList.add('active');
            document.getElementById('listTab').classList.add('active');
        } else {
            alert('Error: ' + result.error);
        }
    } catch (err) {
        console.error('Fetch error:', err);
        alert('Terjadi kesalahan!');
    }
}

// Open edit modal
function openEditModal(id, nama, nominal, notes) {
    document.getElementById('editId').value = id;
    document.getElementById('editNama').value = nama;
    document.getElementById('editNominal').value = nominal;
    document.getElementById('editNotes').value = notes;
    
    // Update currency preview
    document.getElementById('editCurrencyPreview').textContent = formatCurrency(nominal);
    
    document.getElementById('editModal').style.display = 'block';
}

// Close edit modal
function closeEditModal() {
    document.getElementById('editModal').style.display = 'none';
}

// Save edit
async function saveEdit() {
    const id = document.getElementById('editId').value;
    const nama = document.getElementById('editNama').value;
    const nominal = Number(document.getElementById('editNominal').value) || 0;
    const notes = document.getElementById('editNotes').value;

    if (!nama) {
        alert("Nama is required");
        return;
    }

    if (nominal <= 0) {
        alert("Nominal must be greater than 0");
        return;
    }

    try {
        const response = await fetch(`?handler=EditKebutuhan`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': getToken()
            },
            body: JSON.stringify({ id, nama, nominal, notes })
        });
        const result = await response.json();
        if (result.success) {
            closeEditModal();
            await loadKebutuhanList();
            alert('Data berhasil diupdate!');
        } else {
            alert('Error: ' + result.error);
        }
    } catch (err) {
        console.error('Edit error:', err);
        alert('Terjadi kesalahan!');
    }
}

// Delete Kebutuhan
async function deleteKebutuhan(id) {
    if (!confirm('Are you sure you want to delete this?')) return;
    
    try {
        const response = await fetch(`?handler=Delete`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': getToken()
            },
            body: JSON.stringify({ id })
        });
        const result = await response.json();
        if (result.success) {
            await loadKebutuhanList();
            alert('Data berhasil dihapus!');
        } else {
            alert('Error: ' + result.error);
        }
    } catch (err) {
        console.error('Delete error:', err);
        alert('Terjadi kesalahan!');
    }
}

// Initialize SPA
document.addEventListener('DOMContentLoaded', () => {
    loadKebutuhanList();
});

// Close modal when clicking outside
window.onclick = function(event) {
    const modal = document.getElementById('editModal');
    if (event.target === modal) {
        closeEditModal();
    }
}
</script>

<!-- STYLES -->
<style>
.app {
    display: flex;
    height: 100vh;
}
.sidebar {
    width: 200px;
    border-right: 2px solid var(--border-color);
    padding: 10px;
    background-color: var(--secondary-bg);
}
.sidebar button {
    display: block;
    width: 100%;
    margin-bottom: 10px;
}
.content {
    flex: 1;
    padding: 20px;
    overflow-y: auto;
}
.view {
    display: none;
}
.view.active {
    display: block;
}

/* TAB NAVIGATION */
.tab-nav {
    display: flex;
    border-bottom: 2px solid var(--text-primary);
    margin-bottom: 20px;
    gap: 0;
}
.tab-button {
    padding: 12px 24px;
    background-color: var(--secondary-bg);
    border: 2px solid var(--text-primary);
    border-bottom: none;
    cursor: pointer;
    font-family: 'Courier New', Courier, monospace;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.9rem;
    margin-right: -2px;
    transition: all 0.2s;
}
.tab-button:hover {
    background-color: var(--primary-bg);
}
.tab-button.active {
    background-color: var(--primary-bg);
    border-bottom: 2px solid var(--primary-bg);
    margin-bottom: -2px;
}

/* TAB CONTENT */
.tab-content-wrapper {
    min-height: 400px;
}
.tab-content {
    display: none;
}
.tab-content.active {
    display: block;
}

.modal {
    display: none;
    position: fixed;
    left: 0; 
    top: 0;
    width: 100%; 
    height: 100%;
    background: rgba(0,0,0,0.5);
    z-index: 1000;
}
.modal-content {
    background-color: var(--primary-bg);
    margin: 5% auto;
    padding: 0;
    border: 2px solid var(--text-primary);
    width: 90%;
    max-width: 500px;
}
.modal-header {
    padding: 15px 20px;
    border-bottom: 2px solid var(--text-primary);
    display: flex;
    justify-content: space-between;
    align-items: center;
}
.modal-header h3 {
    margin: 0;
    padding: 0;
    border: none;
    background: none;
}
.modal-header .btn {
    font-size: 1.5rem;
    padding: 0;
    width: 30px;
    height: 30px;
    border: none;
}
.modal form, .modal-content > input, .modal-content > label, .modal-content > p {
    padding: 0 20px;
}
.modal-content > label:first-of-type {
    padding-top: 20px;
}
.modal-footer {
    padding: 15px 20px;
    display: flex;
    gap: 10px;
    justify-content: flex-end;
}
.pagination-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-bottom: 20px;
}
.text-center {
    text-align: center;
}
</style>




