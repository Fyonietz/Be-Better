@page
@model MoneyModel
@using System.Globalization
@{
    ViewData["Title"] = "Money Management"; 
    var culture = new CultureInfo("id-ID"); // Indonesia
}

<h2>@ViewData["Title"]</h2>

<p>@Model.Greet</p>
<form method="post">
  <input asp-for = "kebutuhan.nama" placeholder="Nama"/>
<input asp-for="kebutuhan.nominal"
       type="number"
       step="0.01"
       class="form-control"
       id="nominalInput" />

<p class="text-muted mt-1">
    Formatted: <span id="formattedNominal"></span>
</p>
  <input asp-for = "kebutuhan.notes" placeholder="Notes"/>

  <button type="submit">Tambah</button>
</form>
<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nama</th>
            <th>Nominal</th>
            <th>Notes</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var kebutuhans in Model.Kebutuhan_List)
        {
            <tr>
                <td>@kebutuhans.id</td>
                <td>@kebutuhans.nama</td>
                <td>@kebutuhans.nominal.ToString("C", culture)</td>
                <td>@kebutuhans.notes</td>
            </tr>
        }
    </tbody>
</table>

<script>
  const input = document.getElementById("nominalInput");
  const output = document.getElementById("formattedNominal");

input.addEventListener("input", () => {
    const value = input.value;
    output.textContent = value
        ? Number(value).toLocaleString()
        : "";
});
</script>

