appsettings.json

## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Build Folders
bin/
obj/
out/

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Auto-generated files
*.Designer.cs
*.Generated.cs

# Visual Studio cache files
.vs/
.vscode/
.vsconfig

# Rider IDE
.idea/

# NuGet Packages
*.nupkg
*.snupkg
packages/
.nuget/
project.lock.json
project.fragment.lock.json

# ASP.NET Core
wwwroot/lib/
appsettings.*.json
*.db
*.db-journal
logs/
*.log

# Publish Output
publish/
*.Publish.xml

# Node / npm (if using front-end tools)
node_modules/
npm-debug.log
yarn-error.log
yarn-debug.log

# JetBrains Rider
.idea/
*.sln.iml

# Others
*.DS_Store
*.swp
